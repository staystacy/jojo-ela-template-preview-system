<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: keeps JOJO ELA Preview server running across logout/reboot.

  Install (one-time):
    cp scripts/com.jojo.preview.plist ~/Library/LaunchAgents/
    launchctl load   ~/Library/LaunchAgents/com.jojo.preview.plist

  Stop temporarily:
    launchctl unload ~/Library/LaunchAgents/com.jojo.preview.plist

  Restart (after editing server.js etc.):
    launchctl unload ~/Library/LaunchAgents/com.jojo.preview.plist
    launchctl load   ~/Library/LaunchAgents/com.jojo.preview.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.jojo.preview.plist
    rm ~/Library/LaunchAgents/com.jojo.preview.plist

  Logs:
    tail -f /tmp/jojo-preview.log
    tail -f /tmp/jojo-preview.err
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jojo.preview</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/stacywang/Desktop/Code Project/jojo-ela-template-preview-system/server.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/stacywang/Desktop/Code Project/jojo-ela-template-preview-system</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/tmp/jojo-preview.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/jojo-preview.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
    <key>PORT</key>
    <string>3000</string>
  </dict>
</dict>
</plist>
